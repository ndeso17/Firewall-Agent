<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0D10"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/topFilterBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_toolbar_sort"
            android:tint="#10D070" />

        <ImageButton
            android:id="@+id/topSearchBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_toolbar_search"
            android:tint="#10D070" />

        <ImageButton
            android:id="@+id/topSettingsBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#10D070" />
    </LinearLayout>

    <TextView
        android:id="@+id/screenTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="22dp"
        android:text="Terakhir"
        android:textColor="#F3F4F6"
        android:textSize="52sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="14dp"
        android:background="#11151D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_toolbar_search"
            android:tint="#10D070" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Cari nama atau nomor..."
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingHorizontal="8dp"
            android:textColor="#E5E7EB"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/clearSearchBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#9CA3AF" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/phoneTabPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ListView
                android:id="@+id/recentListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:cacheColorHint="@android:color/transparent"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:listSelector="#17212B"
                android:paddingHorizontal="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/keypadPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E2025"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingHorizontal="22dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/dialNumberText"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:textColor="#D1D5DB"
                    android:textSize="20sp" />

                <include layout="@layout/view_callguard_keypad_grid" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_callguard_circle_dark"
                        android:src="@android:drawable/presence_video_online"
                        android:tint="#E5E7EB" />

                    <ImageButton
                        android:id="@+id/callBtnSim1"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_callguard_circle_green"
                        android:src="@android:drawable/sym_action_call"
                        android:tint="#FFFFFF"
                        android:contentDescription="Call SIM 1" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text=""
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/callBtnSim2"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_callguard_circle_green"
                        android:src="@android:drawable/sym_action_call"
                        android:tint="#FFFFFF"
                        android:contentDescription="Call SIM 2" />

                    <ImageButton
                        android:id="@+id/keypadToggleBtn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_callguard_circle_dark"
                        android:src="@android:drawable/ic_dialog_dialer"
                        android:tint="#E5E7EB" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contactsTabPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/contactsHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memuat kontak..."
                android:textColor="#D1D5DB"
                android:textSize="14sp" />

            <ListView
                android:id="@+id/contactsListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:cacheColorHint="@android:color/transparent"
                android:divider="#2B2D33"
                android:dividerHeight="1dp"
                android:listSelector="#17212B" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/simBoardTabPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Papan SIM"
                android:textColor="#F3F4F6"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/simBoardInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tekan tombol di bawah untuk membuka pengaturan SIM bawaan sistem."
                android:textColor="#D1D5DB"
                android:textSize="14sp" />

            <Button
                android:id="@+id/openSimSettingsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:backgroundTint="#10D070"
                android:text="Buka Pengaturan SIM"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="#1E2025"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_recent_history"
                android:tint="#10D070" />

            <TextView
                android:id="@+id/tabPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Terakhir"
                android:textColor="#10D070"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#A1A1AA" />

            <TextView
                android:id="@+id/tabContacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kontak"
                android:textColor="#A1A1AA"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#A1A1AA" />

            <TextView
                android:id="@+id/tabSimBoard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Papan SIM"
                android:textColor="#A1A1AA"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
