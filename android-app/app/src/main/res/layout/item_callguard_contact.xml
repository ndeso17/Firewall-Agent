<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/contactAvatarText"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_callguard_avatar"
        android:gravity="center"
        android:text="A"
        android:textColor="#10D070"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/contactNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nama Kontak"
            android:textColor="#E5E7EB"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contactNumberText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="+628123456789"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
