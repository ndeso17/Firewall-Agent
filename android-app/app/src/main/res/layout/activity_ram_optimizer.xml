<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#252525">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1FA122"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RAM Optimizer"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/refreshBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:text="Pilih aplikasi untuk force-stop / freeze (suspend) / unfreeze."
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/forceStopBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:text="ForceStop"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/freezeBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:text="Freeze"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/unfreezeBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:text="Unfreeze"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/outputText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="#111111"
        android:padding="10dp"
        android:textColor="#D1D5DB"
        android:textSize="12sp"
        android:typeface="monospace" />

</LinearLayout>
