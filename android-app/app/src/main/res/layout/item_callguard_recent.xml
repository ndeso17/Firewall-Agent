<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="70dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/recentAvatarText"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_callguard_avatar"
        android:gravity="center"
        android:text="A"
        android:textColor="#10D070"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recentMainText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="+62 812-3456-7890"
            android:textColor="#E5E7EB"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recentMetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="↙ Indonesia"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recentTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 h lalu"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:src="@android:drawable/ic_dialog_info"
            android:tint="#9CA3AF" />
    </LinearLayout>
</LinearLayout>
